<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAI 태그 모음</title>
    <style>
        :root {
            --bg-color: #1e1e1e;
            --card-bg: #252525;
            --text-color: #d4d4d4;
            --accent-color: #4CAF50;
            --border-color: #333;
        }

        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 600px;
            width: 100%;
            background-color: var(--bg-color);
        }

        h1 {
            font-size: 1.5rem;
            color: #ffffff;
            margin-bottom: 25px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 15px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 10px;
            padding-left: 10px;
            border-left: 4px solid #ffffff;
        }

        /* 프롬프트 박스 스타일 */
        .prompt-box {
            position: relative;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.9rem;
            line-height: 1.5;
            word-break: break-all;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .prompt-box:hover {
            background-color: #2d2d2d;
        }

        .prompt-box::after {
            content: '클릭하여 복사';
            position: absolute;
            top: 5px;
            right: 10px;
            font-size: 0.75rem;
            color: #666;
            font-family: 'Noto Sans KR', sans-serif;
        }

        /* 이미지 업로드 및 그리드 스타일 */
        .image-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .image-wrapper {
            position: relative;
            aspect-ratio: 3 / 4;
            background-color: var(--card-bg);
            border: 1px dashed #555;
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .upload-btn {
            cursor: pointer;
            color: #888;
            font-size: 0.9rem;
            text-align: center;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .upload-btn input {
            display: none;
        }

        /* 토스트 알림 */
        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: var(--accent-color);
            color: white;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Nai 4.5 Full 태그 저장소</h1>

        <!-- 테스트 프롬프트 -->
        <div class="section">
            <div class="section-title">테스트</div>
            <div class="prompt-box" onclick="copyText(this)">
                portrait/full body shot, 1boy/girl, black hair, short hair, wolf cut hair, black eyes, white collared shirt
            </div>
        </div>

        <!-- 기본 프롬프트 -->
        <div class="section">
            <div class="section-title">기본</div>
            <div class="prompt-box" onclick="copyText(this)">
                1.15::artist: dlkrpwjd111 ::, 0.55::artist:sqloveraven::, artist:Mx2j, illust,1.1::highres, 4k, masterpiece, best quality, amazing quality, very aesthetic, absurdres::, no text-2::artist collaboration::
            </div>
        </div>

        <!-- 네거티브 프롬프트 -->
        <div class="section">
            <div class="section-title">네거</div>
